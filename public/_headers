# Cache policy for a static site behind Cloudflare Pages.
#
# Note on matching: Pages matches these patterns against the REQUEST path, so a
# rule for "/*.html" never fires for "/en/" even though that serves index.html.
# HTML therefore needs explicit path rules, and those come last so the asset
# rules above them stay authoritative.

# Plain-text twins for agents: never indexed, served as markdown.
/*.md
  X-Robots-Tag: noindex
  Content-Type: text/markdown; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms-full.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

# Hashed build output: the URL changes when the file changes.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

/uploads/*
  Cache-Control: public, max-age=2592000

/og/*
  Cache-Control: public, max-age=2592000

/icons/*
  Cache-Control: public, max-age=2592000

/pagefind/*
  Cache-Control: public, max-age=604800

/downloads/*
  Cache-Control: public, max-age=86400

# HTML: short edge TTL so a deploy shows up quickly, with stale-while-revalidate
# absorbing crawler bursts instead of passing them to the origin.
/en/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/zh/*
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400

/
  Cache-Control: public, max-age=0, s-maxage=600, stale-while-revalidate=86400
