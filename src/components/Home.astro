---
import Base from '../layouts/Base.astro';
import { channels, ui } from '../i18n/ui';
import { getCollection } from 'astro:content';
import SearchBox from './SearchBox.astro';
import ArticleFeed from './ArticleFeed.astro';
const { lang } = Astro.props;
const t = ui[lang];
const articles = (await getCollection('articles', ({data}) => !data.draft && data.locale === lang))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base lang={lang} title={t.title} description={t.description} translations={{en:'/en/',zh:'/zh/'}}>
  <section class="editorial-hero">
    <div class="hero-copy">
      <p class="eyebrow">EMBEDDED NOTES · ENGINEERING JOURNAL</p>
      <h1>{t.title}</h1>
      <p>{t.description}</p>
      <a class="cta" href="#latest">{t.latest} ↓</a>
    </div>
    <div class="hero-visual">
      <img src="/images/embeddednote-hero.webp"
        alt={lang === 'zh' ? '嵌入式微控制器与PCB电路板' : 'Microcontroller and PCB circuit board'}
        width="1200" height="900" loading="eager" fetchpriority="high" decoding="async" />
      <small>ENGINEERING / EMBEDDED SYSTEMS</small>
    </div>
  </section>
  <section class="topic-strip" aria-label={lang === 'en' ? 'Technical topics' : '技术专题'}>
    {channels.map((c,i) => <a href={`/${lang}/category/${c.slug}/`}><small>{String(i+1).padStart(2,'0')}</small>{c[lang]}</a>)}
  </section>
  <SearchBox lang={lang} />
  <section id="latest" class="editorial-list" data-pagefind-ignore>
    <div class="section-heading">
      <small>LATEST / {new Date().getFullYear()}</small>
      <h2>{t.latest}</h2>
      <small>{String(articles.length).padStart(2,'0')} {lang === 'zh' ? '篇文章' : 'ARTICLES'}</small>
    </div>
    {articles.length
      ? <ArticleFeed entries={articles} lang={lang} headingLevel={3} showCategory={true} />
      : <p>{t.empty}</p>}
  </section>
</Base>
<style>
  .editorial-hero > * {min-width:0}
  .hero-visual{width:100%;min-width:0;align-self:center}
  .hero-visual img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border:1px solid #cfc8bc}
  .hero-visual small{display:block;text-align:right;margin-top:12px;color:#b94530;font:10px system-ui,sans-serif;letter-spacing:.06em}
  @media(max-width:700px){
    .editorial-hero{grid-template-columns:minmax(0,1fr)}
    .hero-visual{display:block;max-width:480px;margin:0 auto}
    .hero-copy h1{overflow-wrap:anywhere}
  }
</style>
