---
interface Props {
  lang: 'en' | 'zh';
  placement?: string;
}
const { lang, placement = 'article' } = Astro.props;
const zh = lang === 'zh';
---
<aside class="supply-cta" aria-label={zh ? '供货咨询' : 'Panel supply'}>
  <div class="supply-cta-body">
    <p class="supply-cta-title">{zh ? '正在为产品选屏?' : 'Specifying a panel for a product?'}</p>
    <p class="supply-cta-text">
      {zh
        ? '这篇文章讲的这类电子纸面板,我们自己供货:0.97 至 31.5 寸,黑白、BWRY 与 E6 六色,配套驱动板、定制排线与点亮固件。'
        : 'We supply the panels this page is about: 0.97 to 31.5 inch, monochrome, BWRY and E6 six-colour, with driver boards, custom FPC and bring-up firmware.'}
    </p>
  </div>
  <a class="supply-cta-link" href={`/${lang}/supply/`} data-en-event="supply_cta_click" data-en-placement={placement}>
    {zh ? '看看我们供什么 →' : 'See what we supply →'}
  </a>
</aside>

<style>
  .supply-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin: 34px 0 8px;
    padding: 18px 20px;
    border: 1px solid #d8d0c3;
    border-left: 4px solid #b94530;
    background: #fbf8f2;
  }
  .supply-cta-body { flex: 1 1 340px; min-width: 0; }
  .supply-cta-title {
    margin: 0 0 5px;
    font: 700 15px/1.4 system-ui, -apple-system, 'Microsoft YaHei', sans-serif;
    color: #17211e;
  }
  .supply-cta-text {
    margin: 0;
    color: #4d574f;
    font-size: 14px;
    line-height: 1.65;
  }
  .supply-cta-link {
    flex: 0 0 auto;
    display: inline-block;
    background: #17211e;
    color: #f8f4ed;
    font: 700 13px/1 system-ui, sans-serif;
    padding: 12px 16px;
    text-decoration: none;
    white-space: nowrap;
  }
  .supply-cta-link:hover { background: #b94530; color: #fff; }
</style>
