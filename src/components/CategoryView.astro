---
import Base from '../layouts/Base.astro';
import { channels, ui } from '../i18n/ui';
import { getCollection } from 'astro:content';
import ArticleFeed from './ArticleFeed.astro';
import Pagination from './Pagination.astro';
const { lang = 'en', slug, page = 1 } = Astro.props;
const c = channels.find(item => item.slug === slug);
if (!c) throw new Error(`Unknown category slug: ${slug}`);
const perPage = 15;
const entries = (await getCollection('articles', ({data}) => !data.draft && data.locale === lang && data.category === slug))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf() || a.id.localeCompare(b.id));
const pageCount = Math.max(1,Math.ceil(entries.length/perPage));
const visible = entries.slice((page-1)*perPage,page*perPage);
const headline = c[lang];

// Keep the brief category-intro on screen; use a distinct, informative SEO description in the head.
const seoDescriptions = {
  'open-source': {
    en: 'Explore open-source embedded projects on GitHub, including schematics, BOMs, key components, firmware, and engineering trade-offs.',
    zh: '探索实用的 GitHub 嵌入式开源项目，涵盖 ESP32、STM32、机器人、电子纸、原理图、BOM 与固件，重点解析关键器件、项目架构和实现方法。'
  },
  'mcu-soc': {
    en: 'Technical coverage of MCUs and SoCs, including STM32, ESP32, RISC-V, processor architecture, peripherals, development boards, and embedded software.',
    zh: '深入了解 MCU 与 SoC 技术，包括 STM32、ESP32、RISC-V、处理器架构、开发板、外设接口和软硬件生态，关注器件选型与实际开发。'
  },
  hardware: {
    en: 'Explore hardware design, PCB layout, power supplies, interface circuits, component selection, and real-world electronics engineering methods.',
    zh: '分享嵌入式硬件设计与 PCB 工程实践，包括原理图、电源电路、接口设计、元器件选型、测试与可靠性分析，结合项目讲解设计取舍。'
  },
  connectivity: {
    en: 'Learn about embedded connectivity using BLE, Wi-Fi, NFC, LoRa, CAN and related protocols, with hands-on hardware projects and integration insights.',
    zh: '关注嵌入式设备通信技术，介绍 BLE、Wi-Fi、NFC、LoRa、CAN 等协议与模块，结合开源项目分析无线连接、网络架构和实际应用。'
  },
  display: {
    en: 'Explore e-paper, TFT, OLED, and Mini LED technologies, with driver ICs, embedded display interfaces, refresh methods, and practical projects.',
    zh: '解析电子纸、TFT、OLED、Mini LED 等显示技术，关注驱动芯片、接口电路、刷新方式、硬件方案及实际嵌入式显示项目。'
  },
  tools: {
    en: 'Embedded engineering tools for IDEs, debugging, simulation, BLE throughput, e-paper images and refresh timing, and NFC transfer planning.',
    zh: '嵌入式工程工具，包括 IDE、调试、仿真、BLE 吞吐率、电子纸图像与刷新时间、NFC 传输估算。'
  }
};
const categorySeoDescription = seoDescriptions[slug][lang];
const seoDescription = page > 1
  ? (lang === 'zh' ? `第 ${page} 页：${categorySeoDescription}` : `Page ${page}: ${categorySeoDescription}`)
  : categorySeoDescription;
---
<Base lang={lang} title={page > 1 ? `${headline} — ${lang === 'zh' ? '第' : 'Page '}${page}${lang === 'zh' ? '页' : ''}` : headline}
  description={seoDescription}
  translations={page === 1 ? {en:`/en/category/${slug}/`,zh:`/zh/category/${slug}/`} : {}}
  switchLinks={{en:`/en/category/${slug}/`,zh:`/zh/category/${slug}/`}} noindex={page > 1}>
  <section class="category-page en-journal-feed">
    <p class="eyebrow">EMBEDDED NOTES / {slug.toUpperCase()}</p>
    <h1>{headline}</h1>
    <p class="category-intro">{lang === 'zh' ? c.zhDesc : c.enDesc}</p>
        <!-- embeddednote-tools-hub-v1.3:start -->
    {slug === 'tools' && page === 1 && (
      <section class="en-tools-hub" aria-label="Interactive engineering tools">
        <div class="en-tools-hub-topline"><span class="en-tools-hub-kicker">INTERACTIVE ENGINEERING TOOLS</span><span class="en-tools-hub-count">02 TOOLS</span></div>
        <div class="en-tools-hub-grid">
          <a class="en-tools-hub-card" href={`/${lang}/tools/ble-throughput-calculator/`} aria-label="Open BLE Throughput & Transfer Planner">
            <span class="en-tools-hub-card-main"><strong>BLE Throughput &amp; Transfer Planner</strong><span class="en-tools-hub-description">Estimate BLE throughput, ATT/L2CAP overhead, DLE/PHY airtime and transfer budgets.</span></span>
            <span class="en-tools-hub-cta" aria-hidden="true">Open Tool <span class="en-tools-hub-arrow">→</span></span>
          </a>
          <a class="en-tools-hub-card" href={`/${lang}/tools/epaper-image-converter/`} aria-label="Open E-Paper Image Converter">
            <span class="en-tools-hub-card-main"><strong>E-Paper Image Converter</strong><span class="en-tools-hub-description">Convert photos to 4-, 6- and 8-color e-paper palettes. Preview dithering and export pixel data.</span></span>
            <span class="en-tools-hub-cta" aria-hidden="true">Open Tool <span class="en-tools-hub-arrow">→</span></span>
          </a>
        </div>
      </section>
    )}
    <!-- embeddednote-tools-hub-v1.3:end -->
    {visible.length ? <ArticleFeed entries={visible} lang={lang} headingLevel={2} showCategory={false} /> : <p>{ui[lang].empty}</p>}
    <Pagination lang={lang} basePath={`/${lang}/category/${slug}/`} page={page} pageCount={pageCount} total={entries.length} perPage={perPage}/>
  </section>
</Base>
<style>
.category-page{min-width:0;padding-top:clamp(26px,4vw,42px)}
.category-intro{margin:0 0 20px;color:#64716a;font-size:clamp(15px,2vw,18px)}
.category-page h1{margin:13px 0 14px}
@media(max-width:700px){.category-page{padding-top:24px}}

/* embeddednote-tools-hub-v1.3:start */
.en-tools-hub{margin:24px 0 36px;min-width:0}
.en-tools-hub-topline{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 11px}
.en-tools-hub-kicker{font:700 11px/1.5 system-ui,sans-serif;letter-spacing:.11em;color:#a63927}
.en-tools-hub-count{font:600 11px/1.5 system-ui,sans-serif;color:#64716a;white-space:nowrap}
.en-tools-hub-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.en-tools-hub-card{display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;gap:22px;min-width:0;min-height:206px;padding:23px 25px;background:#fbf8f2;border:1px solid #d0c8bb;border-left:4px solid #b94530;border-radius:5px;text-decoration:none!important;color:#17211e!important;transition:border-color .15s ease,box-shadow .15s ease,transform .15s ease}
.en-tools-hub-card:hover,.en-tools-hub-card:focus-visible{border-color:#b94530;box-shadow:0 5px 18px rgba(45,31,17,.1);transform:translateY(-2px)}
.en-tools-hub-card:focus-visible{outline:3px solid #b94530;outline-offset:3px}
.en-tools-hub-card-main{display:flex;flex-direction:column;gap:10px;min-width:0}
.en-tools-hub-card strong{display:block;font:700 clamp(19px,2vw,26px)/1.22 Georgia,'Noto Serif',serif;color:#17211e}
.en-tools-hub-description{display:block;font:14px/1.65 system-ui,sans-serif;color:#58635e}
.en-tools-hub-cta{display:inline-flex;align-items:center;justify-content:center;gap:15px;min-height:43px;padding:10px 17px;border-radius:4px;background:#b94530;color:#fff;font:700 14px/1.2 system-ui,sans-serif;white-space:nowrap;transition:background-color .15s ease}
.en-tools-hub-arrow{font-size:19px;line-height:1}
.en-tools-hub-card:hover .en-tools-hub-cta,.en-tools-hub-card:focus-visible .en-tools-hub-cta{background:#933421}
@media(max-width:760px){.en-tools-hub-grid{grid-template-columns:1fr}.en-tools-hub-card{min-height:0;padding:19px 20px;gap:19px}.en-tools-hub{margin:20px 0 30px}}
@media(prefers-reduced-motion:reduce){.en-tools-hub-card,.en-tools-hub-cta{transition:none}.en-tools-hub-card:hover,.en-tools-hub-card:focus-visible{transform:none}}
/* embeddednote-tools-hub-v1.3:end */
</style>
