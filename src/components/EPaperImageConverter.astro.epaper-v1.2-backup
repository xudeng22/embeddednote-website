---
const {lang='en'}=Astro.props;
const zh=lang==='zh';
const t=(en,cn)=>zh?cn:en;
---
<div class="epc" data-epc-lang={lang} data-pagefind-ignore>
  <section class="epc-card epc-presets">
    <h2>{t('Display profiles','屏幕配置')}</h2>
    <div class="epc-form-grid">
      <label>{t('Display profile','显示面板配置')}
        <select id="epc-palette"><option value="four">4-color · BWRY (reference)</option><option value="six" selected>6-color · Spectra 6 (reference)</option><option value="eight">8-color · Illustrative (reference)</option><option value="custom">{t('Imported device profile','导入的设备配置')}</option></select>
      </label>
      <label>{t('Color matching','颜色匹配方式')}
        <select id="epc-matching"><option value="lab" selected>CIE Lab · ΔE76</option><option value="rgb">Weighted RGB · legacy</option></select>
      </label>
      <label>{t('Size preset','尺寸预设')}
        <select id="epc-size"><option value="800x540">800 × 540</option><option value="416x240">416 × 240</option><option value="1200x1600">1200 × 1600</option><option value="1600x1200" selected>1600 × 1200</option><option value="800x528">800 × 528</option><option value="3840x1490">3840 × 1490</option><option value="custom">Custom / 自定义</option></select>
      </label>
      <label>{t('Width (px)','宽度（px）')}<input id="epc-width" type="number" min="1" max="6000" step="1" value="1600" required /></label>
      <label>{t('Height (px)','高度（px）')}<input id="epc-height" type="number" min="1" max="6000" step="1" value="1200" required /></label>
      <label>{t('Resize mode','适配方式')}<select id="epc-fit"><option value="contain">Contain · {t('no crop','不裁切')}</option><option value="cover" selected>Cover · {t('crop to fill','裁切填充')}</option><option value="stretch">Stretch · {t('may distort','可能变形')}</option></select></label>
      <label>{t('Dithering','抖动算法')}<select id="epc-method"><option value="floyd" selected>Floyd–Steinberg</option><option value="atkinson">Atkinson</option><option value="bayer">Bayer 4×4</option><option value="nearest">Nearest color / {t('no dithering','不抖动')}</option></select></label>
    </div>
    <div class="epc-profile-io">
      <label>{t('Import measured palette profile (JSON)','导入实测调色板配置（JSON）')}
        <input type="file" id="epc-profile-file" accept="application/json,.json" />
      </label>
      <button type="button" id="epc-profile-export" class="epc-outline">{t('Export profile template','导出面板配置模板')}</button>
    </div>
    <p class="epc-hint">{t('Measured colors must be sRGB values derived from instrument readings under documented lighting. Editing a JSON flag does not make reference values measured.','实测颜色应由注明光源条件的仪器读数转换为 sRGB；仅修改 JSON 标记不代表完成了屏幕校准。')}</p>
    <div class="epc-adjust">
      <label>{t('Contrast','对比度')} <output id="epc-contrast-label">1.00</output><input id="epc-contrast" type="range" min="0.5" max="1.8" step="0.05" value="1"/></label>
      <label>{t('Saturation','饱和度')} <output id="epc-saturation-label">1.00</output><input id="epc-saturation" type="range" min="0" max="1.8" step="0.05" value="1"/></label>
      <label>{t('Brightness','亮度')} <output id="epc-brightness-label">0</output><input id="epc-brightness" type="range" min="-60" max="60" step="5" value="0"/></label>
    </div>
    <div class="epc-edge">
      <label><input type="checkbox" id="epc-edge" checked /> {t('Protect neutral text and sharp lines','保护中性黑白文字与锐利线条')}</label>
      <label>{t('Edge threshold','边缘检测阈值')} <output id="epc-edge-threshold-label">55</output><input id="epc-edge-threshold" type="range" min="20" max="120" step="5" value="55" /></label>
    </div>
    <p class="epc-hint" id="epc-profile-note">{t('Reference RGB palette—not a device-specific driver encoding or measured screen calibration.','参考 RGB 调色板，不代表特定驱动器的编码或实际屏幕校准结果。')}</p>
  </section>
  <section class="epc-card epc-upload">
    <h2>{t('Image & conversion','图片与转换')}</h2>
    <label class="epc-drop" id="epc-drop">{t('Choose or drop an image (PNG, JPEG, WebP; max 20 MB)','选择或拖入图片（PNG、JPEG、WebP；最多 20 MB）')}
      <input id="epc-file" type="file" accept="image/png,image/jpeg,image/webp" />
    </label>
    <p id="epc-filename" class="epc-subtle" aria-live="polite">{t('No image selected','尚未选择图片')}</p>
    <div class="epc-actions"><button id="epc-convert" type="button" disabled>{t('Convert image','转换图片')}</button><button id="epc-reset" type="button" class="epc-outline">{t('Reset','重置')}</button></div>
    <p id="epc-status" class="epc-status" aria-live="polite">{t('Image files stay in this browser. Nothing is uploaded to our server.','图片仅在本地浏览器处理，不上传到服务器。')}</p>
    <div class="epc-preview-grid">
      <div><h3>{t('Source resized','原图缩放')}</h3><div class="epc-canvas-shell"><canvas id="epc-before" width="400" height="300" aria-label="Source preview"></canvas></div></div>
      <div><h3>{t('Converted reference colors','转换后的参考颜色')}</h3><div class="epc-canvas-shell"><canvas id="epc-after" width="400" height="300" aria-label="Converted preview"></canvas></div></div>
    </div>
  </section>
  <section class="epc-card epc-export">
    <h2>{t('Download & pixel data','导出与点阵数据')}</h2>
    <div id="epc-summary" class="epc-summary">{t('Convert an image to see pixel counts, color mix and export options.','转换后可查看像素、颜色占比与导出格式。')}</div>
    <div id="epc-hist" class="epc-hist"></div>
    <div class="epc-actions"><button id="epc-png" type="button" disabled>{t('Download PNG','下载 PNG')}</button><button id="epc-raw8" type="button" disabled>RAW 8-bit indexes</button><button id="epc-raw4" type="button" disabled>RAW packed 4-bit</button><button id="epc-json" type="button" disabled>{t('Manifest JSON','配置 JSON')}</button></div>
    <p class="epc-hint">{t('RAW codes are palette indices (row-major, high nibble first for 4-bit), not a controller-ready EPD framebuffer. Match native color codes, byte/bit order, panel orientation, row stride and waveform in your firmware.','RAW 导出为调色板索引（逐行排列；4-bit 高半字节在前），并非可直接刷屏的控制器帧缓冲。须在固件中适配颜色编码、字节/位序、方向、行步长及波形。')}</p>
  </section>
</div>
<style>
.epc{--accent:#b94530;--line:#d0c8bb;--paper:#faf7f0;display:grid;gap:16px;margin:18px 0 44px;color:#17211e}.epc-card{min-width:0;border:1px solid var(--line);background:var(--paper);border-radius:5px;padding:clamp(16px,2.2vw,26px)}.epc h2{font:700 clamp(21px,2.4vw,29px)/1.3 Georgia,'Noto Serif SC',serif;margin:0 0 20px}.epc h3{font:700 16px Georgia,'Noto Serif SC',serif;margin:18px 0 10px}.epc-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.epc label{display:grid;gap:6px;font:600 13px/1.5 system-ui,sans-serif}.epc select,.epc input[type=number],.epc input[type=file]{width:100%;min-width:0;border:1px solid #b9b0a2;background:#fff;color:#17211e;padding:10px;font:14px system-ui,sans-serif;border-radius:3px}.epc input[type=range]{width:100%;accent-color:var(--accent)}.epc-adjust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin:20px 0}.epc-profile-io{display:flex;align-items:end;gap:16px;flex-wrap:wrap;margin:14px 0}.epc-profile-io label{flex:1 1 250px}.epc-edge{display:grid;gap:9px;border-top:1px solid var(--line);padding-top:15px}.epc-edge label:first-child{display:flex;align-items:center;gap:10px}.epc-edge input[type=checkbox]{accent-color:var(--accent)}.epc-hint{font:13px/1.6 system-ui,sans-serif;color:#59645e;margin:14px 0 0}.epc-drop{display:block!important;border:2px dashed #c7b9a6;padding:24px;text-align:center;background:#fff;cursor:pointer}.epc-drop.is-dragover{border-color:var(--accent);background:#fff5ed}.epc-drop input{margin-top:12px}.epc-subtle{font:13px/1.5 system-ui;color:#667168;overflow-wrap:anywhere}.epc-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:16px 0}.epc button{border:1px solid var(--accent);background:var(--accent);color:#fff;padding:11px 15px;border-radius:3px;font:600 13px system-ui;cursor:pointer}.epc button:disabled{opacity:.5;cursor:not-allowed}.epc .epc-outline{background:transparent;color:var(--accent)}.epc-status{font:13px/1.5 system-ui;color:#59645e}.epc-preview-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.epc-canvas-shell{min-height:180px;display:grid;place-items:center;background:#eeece5;border:1px solid var(--line);padding:8px;overflow:hidden}.epc canvas{max-width:100%;height:auto;display:block;image-rendering:auto}.epc-summary{font:14px/1.65 system-ui;color:#37433b}.epc-hist{display:flex;flex-wrap:wrap;gap:7px}.epc-chip{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:3px;padding:5px 7px;font:12px system-ui}.epc-swatch{width:13px;height:13px;border:1px solid #999;display:inline-block}.epc button:focus-visible,.epc input:focus-visible,.epc select:focus-visible{outline:2px solid var(--accent);outline-offset:3px}@media(min-width:1050px){.epc{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.epc-presets{grid-column:1}.epc-upload{grid-column:2;grid-row:1/3}.epc-export{grid-column:1}}@media(max-width:650px){.epc-form-grid,.epc-preview-grid,.epc-adjust{grid-template-columns:1fr}.epc-card{padding:16px}.epc-actions button{flex:1 1 130px}.epc-canvas-shell{min-height:120px}}
</style>
<script>
  import {PRESETS, DISPLAY_PROFILES, validateProfile, profilePalette, packed4, MAX_PIXELS} from '../lib/epaper-image.mjs';
  const root=document.querySelector<HTMLElement>('.epc');
  if(root){
    const zh=root.dataset.epcLang==='zh';
    const $=(id:string)=>root.querySelector<HTMLInputElement|HTMLSelectElement|HTMLCanvasElement|HTMLButtonElement>('#'+id)!;
    const file=$('epc-file') as HTMLInputElement;
    const before=$('epc-before') as HTMLCanvasElement,after=$('epc-after') as HTMLCanvasElement;
    const status=$('epc-status'),filename=$('epc-filename'),summary=$('epc-summary'),hist=$('epc-hist');
    const text=(en:string,cn:string)=>zh?cn:en;
    let selected:File|null=null;
    let result:Uint8Array|null=null;
    let worker:Worker|null=null;
    let current=0;
    let options:any=null;
    let importedProfile:any=null;
    const activeProfile=()=> setting('epc-palette')==='custom' ? importedProfile : DISPLAY_PROFILES[setting('epc-palette') as keyof typeof DISPLAY_PROFILES];
    function saveProfileJson(profile:any){
      const url=URL.createObjectURL(new Blob([JSON.stringify(profile,null,2)],{type:'application/json'}));
      const a=document.createElement('a');a.href=url;a.download=`epaper-profile-${profile.id}.json`;a.click();
      setTimeout(()=>URL.revokeObjectURL(url),15000);
    }
    $('epc-profile-export').addEventListener('click',()=>saveProfileJson(activeProfile()||DISPLAY_PROFILES.six));
    $('epc-profile-file').addEventListener('change',async()=>{
      const item=($('epc-profile-file') as HTMLInputElement).files?.[0];if(!item)return;
      if(item.size>16_384){message(text('Profile JSON is too large (max 16 KB).','配置 JSON 过大（最大 16 KB）。'));return;}
      try{importedProfile=validateProfile(JSON.parse(await item.text()));($('epc-palette') as HTMLSelectElement).value='custom';clearResult();
        $('epc-profile-note').textContent=text('Active profile: ','当前面板配置：')+importedProfile.name+(importedProfile.measured?' · measured claim (verify provenance)':' · reference colors');
        message(text('Profile imported. Check measured colors and device codes before use.','配置已导入，请核验实测值及设备颜色编码。'));
      }catch(e:any){message(String(e?.message||e));}
    });
    const setting=(name:string)=>($(name) as HTMLInputElement).value;
    const button=(name:string,enabled:boolean)=>{($('epc-'+name) as HTMLButtonElement).disabled=!enabled;};
    const outputButtons=(v:boolean)=>['png','raw8','raw4','json'].forEach(x=>button(x,v));
    const message=(value:string)=>{status.textContent=value;};
    function clearResult(){current++;worker?.terminate();worker=null;result=null;options=null;outputButtons(false);hist.replaceChildren();summary.textContent='';button('convert',!!selected);}
    const presets=$('epc-size');
    presets.addEventListener('change',()=>{if(setting('epc-size')!=='custom'){const [w,h]=setting('epc-size').split('x');($('epc-width') as HTMLInputElement).value=w;($('epc-height') as HTMLInputElement).value=h;}clearResult();});
    ['epc-width','epc-height'].forEach(id=>$(id).addEventListener('change',()=>{presets.value='custom';clearResult();}));
    ['epc-contrast','epc-saturation','epc-brightness','epc-edge-threshold'].forEach(id=>$(id).addEventListener('input',()=>{$(id+'-label').textContent=(id==='epc-brightness'||id==='epc-edge-threshold'?Number(setting(id)).toFixed(0):Number(setting(id)).toFixed(2));clearResult();}));
    ['epc-palette','epc-fit','epc-method','epc-matching','epc-edge'].forEach(id=>$(id).addEventListener('change',clearResult));
    function acceptFile(f:File|null){
      clearResult();selected=null;button('convert',false);
      if(!f)return;
      if(!['image/png','image/jpeg','image/webp'].includes(f.type)||f.size>20*1024*1024){message(text('Only PNG/JPEG/WebP up to 20 MB are accepted.','仅支持不超过 20 MB 的 PNG/JPEG/WebP。'));return;}
      selected=f;filename.textContent=`${f.name} · ${(f.size/1024/1024).toFixed(2)} MiB`;
      button('convert',true);message(text('Ready. Click Convert image.','已就绪，点击转换图片。'));
    }
    file.addEventListener('change',()=>acceptFile(file.files?.[0]||null));
    const drop=$('epc-drop');
    drop.addEventListener('dragover',(e:Event)=>{e.preventDefault();drop.classList.add('is-dragover');});
    drop.addEventListener('dragleave',()=>drop.classList.remove('is-dragover'));
    drop.addEventListener('drop',(e:Event)=>{e.preventDefault();drop.classList.remove('is-dragover');const f=(e as DragEvent).dataTransfer?.files?.[0];if(f)acceptFile(f);});
    function abort(){current++;worker?.terminate();worker=null;button('convert',!!selected);}
    function save(blob:Blob,suffix:string){const url=URL.createObjectURL(blob);const link=document.createElement('a');link.href=url;link.download=`epaper-${options.width}x${options.height}-${options.mode}-${suffix}`;document.body.append(link);link.click();link.remove();setTimeout(()=>URL.revokeObjectURL(url),15000);}
    function imageLoad(f:File):Promise<HTMLImageElement>{return new Promise((resolve,reject)=>{const url=URL.createObjectURL(f);const image=new Image();image.onload=()=>{URL.revokeObjectURL(url);resolve(image)};image.onerror=()=>{URL.revokeObjectURL(url);reject(new Error('Cannot decode image.'))};image.src=url;});}
    function drawInput(image:HTMLImageElement,w:number,h:number,fit:string){before.width=w;before.height=h;const ctx=before.getContext('2d',{willReadFrequently:true})!;ctx.fillStyle='white';ctx.fillRect(0,0,w,h);ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';const iw=image.naturalWidth,ih=image.naturalHeight;const scale=fit==='cover'?Math.max(w/iw,h/ih):Math.min(w/iw,h/ih);const dw=fit==='stretch'?w:iw*scale,dh=fit==='stretch'?h:ih*scale;ctx.drawImage(image,(w-dw)/2,(h-dh)/2,dw,dh);return ctx.getImageData(0,0,w,h);}
    $('epc-convert').addEventListener('click',async()=>{
      if(!selected)return;abort();clearResult();const id=current;
      const width=Number(setting('epc-width')),height=Number(setting('epc-height'));
      if(!Number.isInteger(width)||!Number.isInteger(height)||width<=0||height<=0||width>6000||height>6000||width*height>MAX_PIXELS){message(text('Invalid dimensions or over 6 million pixels.','尺寸无效或超过 600 万像素。'));return;}
      button('convert',false);message(text('Decoding and converting locally…','正在本地解码并转换…'));
      try{
        const img=await imageLoad(selected);if(id!==current)return;
        if(img.naturalWidth>12000||img.naturalHeight>12000||img.naturalWidth*img.naturalHeight>45_000_000)throw new Error('Source dimensions exceed browser safety limit.');
        const imageData=drawInput(img,width,height,setting('epc-fit'));
        const mode=setting('epc-palette');
        const profile=activeProfile();if(!profile)throw new Error(text('Import a valid profile first.','请先导入有效的面板配置。'));
        const args={width,height,method:setting('epc-method'),matching:setting('epc-matching'),edgeProtection:($('epc-edge') as HTMLInputElement).checked,edgeThreshold:Number(setting('epc-edge-threshold')),contrast:Number(setting('epc-contrast')),saturation:Number(setting('epc-saturation')),brightness:Number(setting('epc-brightness')),palette:profilePalette(profile)};
        worker=new Worker(new URL('../workers/epaper-image.worker.mjs',import.meta.url),{type:'module'});
        worker.onmessage=(e:MessageEvent)=>{
          if(id!==current)return;
          if(!e.data.ok){message(String(e.data.error));abort();return;}
          const out=new Uint8ClampedArray(e.data.rgba);result=new Uint8Array(e.data.indices);
          after.width=width;after.height=height;
          after.getContext('2d')!.putImageData(new ImageData(out,width,height),0,0);
          options={...args,mode,profile,filename:selected?.name,fit:setting('epc-fit'),palette:args.palette,histogram:e.data.histogram};
          const count=width*height;
          summary.textContent=`${width} × ${height} = ${count.toLocaleString()} px · RAW8 ${count.toLocaleString()} B · RAW4 ${Math.ceil(count/2).toLocaleString()} B`;
          hist.replaceChildren();e.data.histogram.forEach((n:number,k:number)=>{const tag=document.createElement('span');tag.className='epc-chip';const sw=document.createElement('i');sw.className='epc-swatch';sw.style.background=args.palette[k].hex;tag.append(sw,document.createTextNode(`${args.palette[k].name}: ${(100*n/count).toFixed(1)}%`));hist.append(tag);});
          outputButtons(true);message(text('Conversion complete. Export uses exact reference palette colors.','转换完成。导出使用参考调色板的精确 RGB 色值。'));
          worker?.terminate();worker=null;button('convert',true);
        };
        worker.onerror=()=>{if(id===current){message(text('Worker error. Please retry in a modern browser.','Worker 出错，请使用新版浏览器重试。'));abort();}};
        worker.postMessage({id,rgba:imageData.data.buffer,options:args},[imageData.data.buffer]);
      }catch(e:any){if(id===current){message(String(e?.message||e));abort();}}
    });
    $('epc-reset').addEventListener('click',()=>{abort();selected=null;file.value='';filename.textContent=text('No image selected','尚未选择图片');clearResult();before.getContext('2d')!.clearRect(0,0,before.width,before.height);after.getContext('2d')!.clearRect(0,0,after.width,after.height);button('convert',false);message(text('Reset complete','已重置'));});
    $('epc-png').addEventListener('click',()=>{if(!result)return;after.toBlob(b=>{if(b)save(b,'palette.png');},'image/png');});
    $('epc-raw8').addEventListener('click',()=>{if(result)save(new Blob([result],{type:'application/octet-stream'}),'index8.bin');});
    $('epc-raw4').addEventListener('click',()=>{if(result)save(new Blob([packed4(result)],{type:'application/octet-stream'}),'index4.bin');});
    $('epc-json').addEventListener('click',()=>{if(result)save(new Blob([JSON.stringify({generator:'EmbeddedNote E-Paper Image Converter v1.1',...options,indexMapping:'zero-based order of palette array',rowOrder:'top-to-bottom,left-to-right',packed4:'first pixel high nibble, odd trailing pixel low nibble zero-filled',raw8:'one zero-based index per pixel',warning:'Palette indices only. Native color codes are in profile.colors[].code; measured swatches are appearance references, never on-wire codes.'},null,2)],{type:'application/json'}),'manifest.json');});
  }
</script>
