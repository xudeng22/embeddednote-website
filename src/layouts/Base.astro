---
import '../styles/global.css';
const {title='EmbeddedNote 嵌入式杂谈',description='嵌入式系统、开源硬件、芯片与工程实践'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site).toString();
const links=[['开源项目','/category/open-source/'],['MCU & SoC','/category/mcu-soc/'],['硬件设计','/category/hardware/'],['通信技术','/category/connectivity/'],['显示技术','/category/display/'],['开发工具','/category/tools/']];
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="alternate" type="application/rss+xml" title="EmbeddedNote RSS" href="/rss.xml"/></head><body><header><div class="shell top"><a class="brand" href="/">◈ EmbeddedNote <small>嵌入式杂谈</small></a><nav>{links.map(([name,href])=><a href={href}>{name}</a>)}</nav></div></header><main class="shell"><slot/></main><footer><div class="shell">© {new Date().getFullYear()} EmbeddedNote · 内容版权以各文章说明为准 · <a href="/about/">关于</a> · <a href="/rss.xml">RSS</a></div></footer></body></html>
