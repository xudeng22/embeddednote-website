---
import '../styles/global.css';
import '../styles/v2-mobile-seo.css';
import '../styles/v28-journal.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { channels, ui } from '../i18n/ui';

const {
  lang = 'en',
  title,
  description,
  translations = {},
  switchLinks = translations,
  article = false,
  homepage = false,
  activeCategory = null,
  image = null,
  imageAlt = null,
  noindex = false,
  publishedTime = null,
  modifiedTime = null,
  breadcrumbs = null
} = Astro.props;
const dict = ui[lang];
const pathname = Astro.url.pathname;
// Match channel pages (including /page/N/) and preserve an article's category.
// Home, About, Contact and Privacy deliberately have no selected channel.
const routeCategory = pathname.match(/^\/(?:en|zh)\/category\/([^/]+)(?:\/|$)/)?.[1];
const currentCategory = activeCategory ?? routeCategory ?? null;
const origin = 'https://embeddednote.com';
const rawTitle = title ?? 'EmbeddedNote';

// Search results truncate around 580-600 px, which is roughly 55-60 characters
// of Latin text. CJK glyphs are about twice as wide, so count them as two units
// and only append the site suffix when the result still fits.
const TITLE_SUFFIX = ' | EmbeddedNote';
const TITLE_BUDGET = 62;
const displayWidth = (value) =>
  [...value].reduce((total, char) => total + (/[\u2e80-\u9fff\uff00-\uffef]/.test(char) ? 2 : 1), 0);
const pageTitle = /embeddednote/i.test(rawTitle)
  ? rawTitle
  : displayWidth(rawTitle) + displayWidth(TITLE_SUFFIX) <= TITLE_BUDGET
    ? `${rawTitle}${TITLE_SUFFIX}`
    : rawTitle;

const pageDesc = description ?? dict.description;
const canonical = new URL(Astro.url.pathname, origin).href;
const alternates = Object.entries(translations).filter(([, path]) => Boolean(path));
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';

// Every article ships its own 1200x630 card; pages without one fall back to the
// site hero, which keeps a 4:3 ratio. Dimensions are declared so crawlers and
// social clients can reserve space before the file is fetched.
const hasArticleCard = Boolean(image);
const socialPath = image ?? '/images/embeddednote-hero.webp';
const socialImage = new URL(socialPath, origin).href;
const socialWidth = hasArticleCard ? 1200 : 1200;
const socialHeight = hasArticleCard ? 630 : 900;
const socialType = socialPath.endsWith('.png') ? 'image/png' : 'image/webp';

const tagline = lang === 'en'
  ? 'From a chip and a small project to the industry supply chain — documenting reusable engineering insights'
  : '从一个芯片、一个小项目到产业链，记录可复用的工程判断';

const siteIdentity = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type':'Organization','@id':`${origin}/#publisher`,name:'EmbeddedNote',alternateName:'嵌入式杂谈',
      url:`${origin}/`,
      description:'An independent bilingual engineering publication covering embedded systems, MCU/SoC selection, hardware design, BLE connectivity, e-paper displays and open-source hardware, with free browser-based engineering tools.',
      contactPoint:{'@type':'ContactPoint',email:'xden2019@gmail.com',contactType:'editorial inquiries'},
      logo:{'@type':'ImageObject',url:`${origin}/images/embeddednote-logo.webp`},
      founder:{'@id':`${origin}/#founder`},
      sameAs:['https://github.com/xudeng22','https://x.com/GaryxuEmbedded'],
      knowsAbout:['Embedded systems','E-paper displays','Bluetooth Low Energy','ESP32','PCB design','Open-source hardware']
    },
    {
      '@type':'Person','@id':`${origin}/#founder`,name:'Gary Xu',
      url:`${origin}/en/about/`,
      sameAs:['https://github.com/xudeng22','https://x.com/GaryxuEmbedded'],
      worksFor:{'@id':`${origin}/#publisher`},
      knowsAbout:['Embedded systems','E-paper displays','Bluetooth Low Energy','ESP32']
    },
    {
      '@type':'WebSite','@id':`${origin}/#website`,name:'EmbeddedNote',url:`${origin}/`,inLanguage:['en','zh-CN'],publisher:{'@id':`${origin}/#publisher`},
      description:'An independent bilingual engineering blog with free tools, covering embedded systems, connectivity, displays and open-source hardware.',
      potentialAction:{'@type':'SearchAction',target:{'@type':'EntryPoint',urlTemplate:`${origin}/${lang}/?q={search_term_string}`},'query-input':'required name=search_term_string'}
    }
  ]
};

const breadcrumbLd = breadcrumbs && breadcrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((crumb, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: crumb.name,
        ...(crumb.path ? { item: new URL(crumb.path, origin).href } : {})
      }))
    }
  : null;
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:site_name" content="EmbeddedNote" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialType} />
    <meta property="og:image:width" content={String(socialWidth)} />
    <meta property="og:image:height" content={String(socialHeight)} />
    <meta property="og:image:alt" content={imageAlt ?? 'EmbeddedNote embedded engineering and PCB'} />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {article && <meta property="article:publisher" content={`${origin}/`} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={socialImage} />
    {alternates.map(([locale, path]) => <link rel="alternate" hreflang={locale === 'zh' ? 'zh-CN' : 'en'} href={new URL(path, origin).href} />)}
    {translations.en && <link rel="alternate" hreflang="x-default" href={new URL(translations.en, origin).href} />}
    <script type="application/ld+json" set:html={JSON.stringify(siteIdentity)} />
    {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  </head>
  <body>
    <header class="masthead">
      <div class="shell masthead-inner">
        <a href={`/${lang}/`} class="brand brand-image-link" aria-label="EmbeddedNote homepage">
          <img
            class="brand-image"
            src="/images/embeddednote-logo-480.webp"
            srcset="/images/embeddednote-logo-480.webp 480w, /images/embeddednote-logo-960.webp 960w"
            sizes="240px"
            alt="EmbeddedNote"
            width="480"
            height="75"
            decoding="async"
          />
        </a>
        <span class="masthead-tagline">{tagline}</span>
        <div class="masthead-actions">
          <a class="masthead-supply" href={`/${lang}/supply/`} data-en-event="supply_nav_click" data-en-placement="masthead">{lang === 'zh' ? '供货' : 'Supply'}</a>
          <LanguageSwitcher lang={lang} translations={switchLinks} />
        </div>
      </div>
      <nav class="mainnav" aria-label={lang === 'zh' ? '技术导航' : 'Technical navigation'}>
        <div class="shell navlinks">
          {[
            { href: `/${lang}/e-paper/`, label: lang === 'zh' ? '电子纸' : 'E-paper' },
            { href: `/${lang}/connectivity/`, label: lang === 'zh' ? '低功耗无线' : 'Connectivity' },
            { href: `/${lang}/notes/`, label: lang === 'zh' ? '笔记' : 'Notes' }
          ].map(link => <a
            href={link.href}
            class={pathname === link.href ? 'is-current-category' : undefined}
            aria-current={pathname === link.href ? 'page' : undefined}
          >{link.label}</a>)}

        </div>
      </nav>
    </header>
    <main class:list={['shell', {'en-home-layout': homepage}]}><slot /></main>
    <footer class="en-site-footer">
      <div class="shell en-footer-inner">
        <a href={`/${lang}/`} class="en-footer-brand" aria-label="EmbeddedNote homepage">Embedded<span>Note</span></a>
        <nav class="en-footer-links" aria-label={lang === 'zh' ? '页脚链接' : 'Footer links'}>
          <a href={`/${lang}/supply/`} class="en-footer-supply">{lang === 'zh' ? '供货与方案' : 'Supply'}</a>
          <!-- embeddednote-footer-tools-v1.4:start -->
          <a href={`/${lang}/tools/ble-throughput-calculator/`}>{lang === 'zh' ? 'BLE 传输规划器' : 'BLE Transfer Planner'}</a>
          <span aria-hidden="true">|</span>
          <a href={`/${lang}/tools/epaper-image-converter/`}>{lang === 'zh' ? '电子纸图像转换器' : 'E-Paper Image Converter'}</a>
          <span aria-hidden="true">|</span>
          <!-- embeddednote-footer-tools-v1.4:end -->
          <!-- embeddednote-growth-v1:start -->
          <a href={`/${lang}/partner/`} data-en-event="partner_link_click" data-en-placement="footer">{lang === 'zh' ? '商务合作' : 'Partner With Us'}</a>
          <span aria-hidden="true">|</span>
          <!-- embeddednote-growth-v1:end -->
          <a href={`/${lang}/contact/`}>{lang === 'zh' ? '联系我们' : 'Contact'}</a>
          <span aria-hidden="true">|</span>
          <a href={`/${lang}/about/`}>{dict.about}</a>
          <span aria-hidden="true">|</span>
          <a href={`/${lang}/privacy/`}>{lang === 'zh' ? '隐私政策' : 'Privacy Policy'}</a>
        </nav>
        <p class="en-footer-copyright">© {new Date().getFullYear()} EmbeddedNote. {lang === 'zh' ? '保留所有权利。' : 'All rights reserved.'}</p>
      </div>
    </footer>
    <AnalyticsConsent />
    {/* AdSense: same publisher account and loader, moved below the document so it
        no longer competes with the first paint. Auto ads still render. */}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9169011296822300" crossorigin="anonymous"></script>
  </body>
</html>
