---
import '../styles/global.css';
import '../styles/v2-mobile-seo.css';
import '../styles/v28-journal.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { channels, ui } from '../i18n/ui';

const { lang = 'en', title, description, translations = {}, switchLinks = translations, article = false, homepage = false, activeCategory = null } = Astro.props;
const dict = ui[lang];
const pathname = Astro.url.pathname;
// Match channel pages (including /page/N/) and preserve an article's category.
// Home, About, Contact and Privacy deliberately have no selected channel.
const routeCategory = pathname.match(/^\/(?:en|zh)\/category\/([^/]+)(?:\/|$)/)?.[1];
const currentCategory = activeCategory ?? routeCategory ?? null;
const origin = 'https://embeddednote.com';
const rawTitle = title ?? 'EmbeddedNote';
const pageTitle = /embeddednote/i.test(rawTitle) ? rawTitle : `${rawTitle} | EmbeddedNote`;
const pageDesc = description ?? dict.description;
const canonical = new URL(Astro.url.pathname, origin).href;
const alternates = Object.entries(translations).filter(([, path]) => Boolean(path));
const ogLocale = lang === 'zh' ? 'zh_CN' : 'en_US';
const socialImage = new URL('/images/embeddednote-hero.webp', origin).href;
const tagline = lang === 'en'
  ? 'From a chip and a small project to the industry supply chain — documenting reusable engineering insights'
  : '从一个芯片、一个小项目到产业链，记录可复用的工程判断';
const siteIdentity = {
  '@context': 'https://schema.org',
  '@graph': [
    {'@type':'Organization','@id':`${origin}/#publisher`,name:'EmbeddedNote',url:`${origin}/`,contactPoint:{'@type':'ContactPoint',email:'xden2019@gmail.com',contactType:'editorial inquiries'},logo:{'@type':'ImageObject',url:`${origin}/images/embeddednote-logo.webp`}},
    {'@type':'WebSite','@id':`${origin}/#website`,name:'EmbeddedNote',url:`${origin}/`,inLanguage:['en','zh-CN'],publisher:{'@id':`${origin}/#publisher`},description:'A bilingual publication on practical embedded engineering and open-source projects.'}
  ]
};
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9169011296822300" crossorigin="anonymous"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:site_name" content="EmbeddedNote" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="EmbeddedNote embedded engineering and PCB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={socialImage} />
    {alternates.map(([locale, path]) => <link rel="alternate" hreflang={locale === 'zh' ? 'zh-CN' : 'en'} href={new URL(path, origin).href} />)}
    {translations.en && <link rel="alternate" hreflang="x-default" href={new URL(translations.en, origin).href} />}
    <script type="application/ld+json" set:html={JSON.stringify(siteIdentity)} />
  </head>
  <body>
    <header class="masthead">
      <div class="shell masthead-inner">
        <a href={`/${lang}/`} class="brand brand-image-link" aria-label="EmbeddedNote homepage">
          <img class="brand-image" src="/images/embeddednote-logo.webp" alt="EmbeddedNote" width="1628" height="253" decoding="async" />
        </a>
        <span class="masthead-tagline">{tagline}</span>
        <LanguageSwitcher lang={lang} translations={switchLinks} />
      </div>
      <nav class="mainnav" aria-label={lang === 'zh' ? '技术导航' : 'Technical navigation'}>
        <div class="shell navlinks">
          {channels.map(c => <a
            href={`/${lang}/category/${c.slug}/`}
            class={currentCategory === c.slug ? 'is-current-category' : undefined}
            aria-current={pathname === `/${lang}/category/${c.slug}/` ? 'page' : undefined}
          >{c[lang]}</a>)}
        </div>
      </nav>
    </header>
    <main class:list={['shell', {'en-home-layout': homepage}]}><slot /></main>
    <footer class="en-site-footer">
      <div class="shell en-footer-inner">
        <a href={`/${lang}/`} class="en-footer-brand" aria-label="EmbeddedNote homepage">Embedded<span>Note</span></a>
        <nav class="en-footer-links" aria-label={lang === 'zh' ? '页脚链接' : 'Footer links'}>
          <a href={`/${lang}/contact/`}>{lang === 'zh' ? '联系我们' : 'Contact'}</a>
          <span aria-hidden="true">|</span>
          <a href={`/${lang}/about/`}>{dict.about}</a>
          <span aria-hidden="true">|</span>
          <a href={`/${lang}/privacy/`}>{lang === 'zh' ? '隐私政策' : 'Privacy Policy'}</a>
        </nav>
        <p class="en-footer-copyright">© {new Date().getFullYear()} EmbeddedNote. {lang === 'zh' ? '保留所有权利。' : 'All rights reserved.'}</p>
      </div>
    </footer>
  </body>
</html>
