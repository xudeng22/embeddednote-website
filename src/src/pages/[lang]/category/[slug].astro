---
import Base from '../../../layouts/Base.astro';
import {channels,ui} from '../../../i18n/ui';
import {getCollection} from 'astro:content';
export function getStaticPaths(){
  const langs=['en','zh'];
  const slugs=['open-source','mcu-soc','hardware','connectivity','display','tools'];
  return langs.flatMap(lang=>slugs.map(slug=>({params:{lang,slug}})));
}
const lang=Astro.params.lang;
const slug=Astro.params.slug;
const c=channels.find(item=>item.slug===slug);
const entries=(await getCollection('articles', ({data})=>!data.draft && data.locale===lang && data.category===slug)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Base lang={lang} title={c[lang]} description={lang==='zh'?c.zhDesc:c.enDesc} translations={{en:`/en/category/${slug}/`,zh:`/zh/category/${slug}/`}}><section class="category-page"><p class="eyebrow">EMBEDDED NOTES / {slug.toUpperCase()}</p><h1>{c[lang]}</h1><p>{lang==='zh'?c.zhDesc:c.enDesc}</p>{entries.length ? entries.map(a=><article class="editorial-item"><div><p class="meta">{a.data.pubDate.toISOString().slice(0,10)}</p><h2><a href={`/${lang}/articles/${a.id.split('/').slice(1).join('/')}/`}>{a.data.title}</a></h2><p>{a.data.description}</p></div></article>) : <p>{ui[lang].empty}</p>}</section></Base>
