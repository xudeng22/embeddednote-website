---
import Base from '../layouts/Base.astro';import {getCollection} from 'astro:content';
const cats=[['开源项目','open-source','GitHub、开源工程与器件 BOM'],['MCU & SoC','mcu-soc','STM32、ESP32、RISC-V'],['硬件设计','hardware','PCB、电源、接口电路'],['通信技术','connectivity','BLE、Wi-Fi、NFC、CAN'],['显示技术','display','电子纸、TFT、Mini LED'],['开发工具','tools','IDE、调试、仿真与测试']];
const articles=(await getCollection('articles',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<Base><section class="hero"><h1>EmbeddedNote · 嵌入式杂谈</h1><p>Practical Embedded Engineering · 芯片、硬件、开源项目与工程实践</p></section><div class="search"><div id="search"></div></div><link href="/pagefind/pagefind-ui.css" rel="stylesheet"/><script is:inline src="/pagefind/pagefind-ui.js"></script><script is:inline>window.addEventListener('DOMContentLoaded',()=>{if(window.PagefindUI)new PagefindUI({element:'#search',showSubResults:true,translations:{placeholder:'搜索芯片型号、协议、项目或关键字'}});});</script><h2>六大技术频道</h2><div class="category-grid">{cats.map(([name,slug,desc])=><a class="card" href={'/category/'+slug+'/'}><h3>{name} →</h3><p>{desc}</p></a>)}</div><h2>最新文章</h2><div class="article-grid">{articles.map(a=><article class="card"><h3><a href={'/articles/'+a.id+'/'}>{a.data.title}</a></h3><p>{a.data.description}</p><span class="meta">{a.data.pubDate.toISOString().slice(0,10)} · {a.data.tags.join(' / ')}</span></article>)}</div></Base>
