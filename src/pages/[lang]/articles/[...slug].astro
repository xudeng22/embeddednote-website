---
import Base from '../../../layouts/Base.astro';
import GiscusComments from '../../../components/GiscusComments.astro';
import ArticleFooterNav from '../../../components/ArticleFooterNav.astro';
import SupplyCta from '../../../components/SupplyCta.astro';
import { getCollection, render } from 'astro:content';
import { channels } from '../../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection(
    'articles',
    ({ data }) => !data.draft
  );

  return entries.map((article) => {
    const [lang, ...parts] = article.id.split('/');

    if (lang !== article.data.locale || !parts.length) {
      throw new Error(`Invalid locale/id: ${article.id}`);
    }

    const related = entries.filter(
      (item) =>
        item.data.translationKey === article.data.translationKey
    );

    const translations = Object.fromEntries(
      related.map((item) => [
        item.data.locale,
        `/${item.data.locale}/articles/${item.id
          .split('/')
          .slice(1)
          .join('/')}/`
      ])
    );

    return {
      params: {
        lang,
        slug: parts.join('/')
      },
      props: {
        article,
        translations
      }
    };
  });
}

const { article, translations } = Astro.props;

const lang = article.data.locale;
const { Content } = await render(article);

// One 1200x630 card per translation key, generated from the article's first
// body image. See scripts/generate-og-images.py.
const ogImage = `/og/${article.data.translationKey}.webp`;
const ogImageUrl = new URL(ogImage, 'https://embeddednote.com').href;
const canonicalUrl = new URL(Astro.url.pathname, 'https://embeddednote.com').href;

const category = channels.find((c) => c.slug === article.data.category);
const categoryLabel = category?.[lang] ?? article.data.category;

const breadcrumbs = [
  { name: lang === 'zh' ? '首页' : 'Home', path: `/${lang}/` },
  { name: categoryLabel, path: `/${lang}/category/${article.data.category}/` },
  { name: article.data.title }
];

const publishedIso = article.data.pubDate.toISOString();
const modifiedIso = (article.data.updatedDate ?? article.data.pubDate).toISOString();

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.data.title,
  description: article.data.seoDescription ?? article.data.description,
  // An EmbeddedNote byline describes the site; a named writer is a Person.
  author: article.data.author === 'EmbeddedNote'
    ? { '@type': 'Organization', '@id': 'https://embeddednote.com/#publisher', name: 'EmbeddedNote' }
    : { '@type': 'Person', name: article.data.author },
  publisher: { '@id': 'https://embeddednote.com/#publisher' },
  datePublished: publishedIso,
  dateModified: modifiedIso,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  image: [ogImageUrl],
  thumbnailUrl: ogImageUrl,
  articleSection: categoryLabel,
  keywords: article.data.tags.join(', '),
  isPartOf: { '@id': 'https://embeddednote.com/#website' }
};
---

<Base
  lang={lang}
  title={article.data.seoTitle ?? article.data.title}
  description={
    article.data.seoDescription ?? article.data.description
  }
  translations={translations}
  article={true}
  activeCategory={article.data.category}
  image={ogImage}
  imageAlt={article.data.title}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  breadcrumbs={breadcrumbs}
>
  <article class="prose" data-pagefind-body>
    <nav class="en-breadcrumb" aria-label={lang === 'zh' ? '面包屑' : 'Breadcrumb'}>
      <ol>
        {breadcrumbs.map((crumb, index) => (
          <li>
            {crumb.path
              ? <a href={crumb.path}>{crumb.name}</a>
              : <span aria-current="page">{crumb.name}</span>}
            {index < breadcrumbs.length - 1 && <span class="en-breadcrumb__sep" aria-hidden="true">›</span>}
          </li>
        ))}
      </ol>
    </nav>

    <p class="eyebrow">
      EMBEDDED NOTES · {article.data.category.toUpperCase()}
    </p>

    <h1>{article.data.title}</h1>

    <p class="meta">
      <time datetime={article.data.pubDate.toISOString().slice(0, 10)}>
        {article.data.pubDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'})}
      </time>
      {' · '}
      <!-- embeddednote-p0-v2:editorial -->
      <span>{lang === 'zh' ? '作者：' : 'By '}{article.data.author === 'EmbeddedNote'
        ? <a href={`/${lang}/about/`}>EmbeddedNote</a>
        : article.data.author}</span>
      {article.data.updatedDate && article.data.updatedDate > article.data.pubDate && (
        <span> · {lang === 'zh' ? '更新：' : 'Updated '}
          <time datetime={article.data.updatedDate.toISOString().slice(0, 10)}>
            {article.data.updatedDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'})}
          </time>
        </span>
      )}
      {' · '}
      {article.data.tags.join(' / ')}
      {' · '}
      <a href={`/${lang}/about/`}>{lang === 'zh' ? '编辑与证据说明' : 'Editorial method'}</a>
    </p>

    <Content />

    {
      article.data.sourceUrl && (
        <p>
          <a
            href={article.data.sourceUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {article.data.sourceUrl}
          </a>
        </p>
      )
    }
  </article>

  {article.data.supplyCta && <SupplyCta lang={lang} placement="article" />}

  <ArticleFooterNav article={article} lang={lang} />

  <GiscusComments
    lang={lang}
    term={article.data.translationKey}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonld)}
  />
</Base>

<style>
  .en-breadcrumb {margin:0 0 18px; font:500 12px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;}
  .en-breadcrumb ol {display:flex; flex-wrap:wrap; gap:6px; margin:0; padding:0; list-style:none;}
  .en-breadcrumb li {display:inline-flex; align-items:center; gap:6px; color:#6f7772; min-width:0;}
  .en-breadcrumb a {color:#8f3c2c;}
  .en-breadcrumb a:hover {text-decoration:underline;}
  .en-breadcrumb span[aria-current] {color:#3d4a44; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:min(52ch,60vw);}
  .en-breadcrumb__sep {color:#b6aaa0;}
</style>
