
---
import Base from '../../../layouts/Base.astro';
import GiscusComments from '../../../components/GiscusComments.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection(
    'articles',
    ({ data }) => !data.draft
  );

  return entries.map((article) => {
    const [lang, ...parts] = article.id.split('/');

    if (lang !== article.data.locale || !parts.length) {
      throw new Error(`Invalid locale/id: ${article.id}`);
    }

    const related = entries.filter(
      (item) =>
        item.data.translationKey === article.data.translationKey
    );

    const translations = Object.fromEntries(
      related.map((item) => [
        item.data.locale,
        `/${item.data.locale}/articles/${item.id
          .split('/')
          .slice(1)
          .join('/')}/`
      ])
    );

    return {
      params: {
        lang,
        slug: parts.join('/')
      },
      props: {
        article,
        translations
      }
    };
  });
}

const { article, translations } = Astro.props;

const lang = article.data.locale;
const { Content } = await render(article);

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.data.title,
  description: article.data.description,
  author: { '@type': 'Organization', '@id': 'https://embeddednote.com/#publisher', name: article.data.author },
  publisher: { '@id': 'https://embeddednote.com/#publisher' },
  datePublished: article.data.pubDate.toISOString(),
  dateModified: (
    article.data.updatedDate ?? article.data.pubDate
  ).toISOString(),
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  mainEntityOfPage: new URL(
    Astro.url.pathname,
    'https://embeddednote.com'
  ).href
};
---

<Base
  lang={lang}
  title={article.data.seoTitle ?? article.data.title}
  description={
    article.data.seoDescription ?? article.data.description
  }
  translations={translations}
  article={true}
  activeCategory={article.data.category}
>
  <article class="prose" data-pagefind-body>
    <p class="eyebrow">
      EMBEDDED NOTES · {article.data.category.toUpperCase()}
    </p>

    <h1>{article.data.title}</h1>

    <p class="meta">
      <time datetime={article.data.pubDate.toISOString().slice(0, 10)}>
        {article.data.pubDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'})}
      </time>
      {' · '}
      <span>{lang === 'zh' ? '作者：' : 'By '}{article.data.author}</span>
      {' · '}
      {article.data.tags.join(' / ')}
    </p>

    <Content />

    {
      article.data.sourceUrl && (
        <p>
          <a
            href={article.data.sourceUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {article.data.sourceUrl}
          </a>
        </p>
      )
    }
  </article>

  <GiscusComments
    lang={lang}
    term={article.data.translationKey}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonld)}
  />
</Base>
