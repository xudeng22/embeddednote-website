---
import Base from '../../../layouts/Base.astro';
import GiscusComments from '../../../components/GiscusComments.astro';
import ArticleFooterNav from '../../../components/ArticleFooterNav.astro';
import SupplyCta from '../../../components/SupplyCta.astro';
import { getCollection, render } from 'astro:content';
import { channels } from '../../../i18n/ui';

export async function getStaticPaths() {
  const entries = await getCollection(
    'articles',
    ({ data }) => !data.draft
  );

  return entries.map((article) => {
    const [lang, ...parts] = article.id.split('/');

    if (lang !== article.data.locale || !parts.length) {
      throw new Error(`Invalid locale/id: ${article.id}`);
    }

    const related = entries.filter(
      (item) =>
        item.data.translationKey === article.data.translationKey
    );

    const translations = Object.fromEntries(
      related.map((item) => [
        item.data.locale,
        `/${item.data.locale}/articles/${item.id
          .split('/')
          .slice(1)
          .join('/')}/`
      ])
    );

    return {
      params: {
        lang,
        slug: parts.join('/')
      },
      props: {
        article,
        translations
      }
    };
  });
}

const { article, translations } = Astro.props;

const lang = article.data.locale;
const { Content } = await render(article);

// One 1200x630 card per translation key, generated from the article's first
// body image. See scripts/generate-og-images.py.
const ogImage = `/og/${article.data.translationKey}.webp`;
const ogImageUrl = new URL(ogImage, 'https://embeddednote.com').href;
const canonicalUrl = new URL(Astro.url.pathname, 'https://embeddednote.com').href;

const category = channels.find((c) => c.slug === article.data.category);
const categoryLabel = category?.[lang] ?? article.data.category;

// Categories were collapsed into three hubs; the crumb points at the hub the
// article actually belongs to, so it never travels through a 301.
const hubFor = (slug: string, series?: string) => {
  if (series === 'epaper' || slug === 'display') {
    return { path: `/${lang}/e-paper/`, en: 'E-paper', zh: '电子纸' };
  }
  if (series === 'ble' || slug === 'connectivity') {
    return { path: `/${lang}/connectivity/`, en: 'Connectivity', zh: '低功耗无线' };
  }
  return { path: `/${lang}/notes/`, en: 'Notes', zh: '笔记' };
};
const hub = hubFor(article.data.category, article.data.series);

const breadcrumbs = [
  { name: lang === 'zh' ? '首页' : 'Home', path: `/${lang}/` },
  { name: lang === 'zh' ? hub.zh : hub.en, path: hub.path },
  { name: article.data.title }
];

const publishedIso = article.data.pubDate.toISOString();
const modifiedIso = (article.data.updatedDate ?? article.data.pubDate).toISOString();

// Question headings (### ...?) become an FAQPage, which answer engines read.
const faqItems: { q: string; a: string }[] = (() => {
  const body = article.body ?? '';
  const blocks = body.split(/\n(?=### )/);
  const items: { q: string; a: string }[] = [];
  for (const block of blocks) {
    const firstLine = block.split('\n')[0].trim();
    if (!firstLine.startsWith('### ') || !firstLine.endsWith('?')) continue;
    const answer = block
      .split('\n')
      .slice(1)
      .join(' ')
      .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
      .replace(/[*_`>#]/g, '')
      .replace(/\s+/g, ' ')
      .trim();
    if (answer.length > 40) {
      items.push({ q: firstLine.slice(4).trim(), a: answer.slice(0, 900) });
    }
  }
  return items.slice(0, 8);
})();

const KNOWN_ENTITIES: Record<string, string> = {
  'spectra 6': 'E Ink Spectra 6',
  'spectra6': 'E Ink Spectra 6',
  'spectra 3100': 'E Ink Spectra 3100',
  'kaleido': 'E Ink Kaleido',
  'ssd1680': 'SSD1680',
  'ssd1675': 'SSD1675',
  'ssd1683': 'SSD1683',
  'uc8151': 'UC8151',
  'raw4': 'RAW4 image packing',
  'e-paper': 'Electronic paper',
  'electronic paper': 'Electronic paper',
  'eink': 'E Ink'
};

const entityNames = new Set<string>();
for (const value of [article.data.title, ...(article.data.tags ?? [])]) {
  for (const [needle, name] of Object.entries(KNOWN_ENTITIES)) {
    if (String(value).toLowerCase().includes(needle)) entityNames.add(name);
  }
}

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: article.data.title,
  description: article.data.seoDescription ?? article.data.description,
  // An EmbeddedNote byline describes the site; a named writer is a Person.
  author: article.data.author === 'EmbeddedNote'
    ? { '@type': 'Organization', '@id': 'https://embeddednote.com/#publisher', name: 'EmbeddedNote' }
    : { '@type': 'Person', name: article.data.author },
  publisher: { '@id': 'https://embeddednote.com/#publisher' },
  datePublished: publishedIso,
  dateModified: modifiedIso,
  inLanguage: lang === 'zh' ? 'zh-CN' : 'en',
  url: canonicalUrl,
  mainEntityOfPage: canonicalUrl,
  image: [ogImageUrl],
  thumbnailUrl: ogImageUrl,
  articleSection: categoryLabel,
  keywords: article.data.tags.join(', '),
  about: (article.data.tags ?? []).map((t: string) => ({ '@type': 'Thing', name: t })),
  mentions: [...entityNames].map((name: string) => ({ '@type': 'Thing', name })),
  isPartOf: { '@id': 'https://embeddednote.com/#website' }
};
---

<Base
  lang={lang}
  title={article.data.seoTitle ?? article.data.title}
  description={
    article.data.seoDescription ?? article.data.description
  }
  translations={translations}
  article={true}
  activeCategory={article.data.category}
  image={ogImage}
  imageAlt={article.data.title}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  breadcrumbs={breadcrumbs}
>
  <article class="prose" data-pagefind-body>
    <nav class="en-breadcrumb" aria-label={lang === 'zh' ? '面包屑' : 'Breadcrumb'}>
      <ol>
        {breadcrumbs.map((crumb, index) => (
          <li>
            {crumb.path
              ? <a href={crumb.path}>{crumb.name}</a>
              : <span aria-current="page">{crumb.name}</span>}
            {index < breadcrumbs.length - 1 && <span class="en-breadcrumb__sep" aria-hidden="true">›</span>}
          </li>
        ))}
      </ol>
    </nav>

    <p class="eyebrow">
      EMBEDDED NOTES · {article.data.category.toUpperCase()}
    </p>

    <h1>{article.data.title}</h1>

    <p class="meta">
      <time datetime={article.data.pubDate.toISOString().slice(0, 10)}>
        {article.data.pubDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'})}
      </time>
      {' · '}
      <!-- embeddednote-p0-v2:editorial -->
      <span>{lang === 'zh' ? '作者：' : 'By '}{article.data.author === 'EmbeddedNote'
        ? <a href={`/${lang}/about/`}>EmbeddedNote</a>
        : article.data.author}</span>
      {article.data.updatedDate && article.data.updatedDate > article.data.pubDate && (
        <span> · {lang === 'zh' ? '更新：' : 'Updated '}
          <time datetime={article.data.updatedDate.toISOString().slice(0, 10)}>
            {article.data.updatedDate.toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US', {year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC'})}
          </time>
        </span>
      )}
      {' · '}
      {article.data.tags.join(' / ')}
      {' · '}
      <a href={`/${lang}/about/`}>{lang === 'zh' ? '编辑与证据说明' : 'Editorial method'}</a>
    </p>

    <Content />

    {
      article.data.sourceUrl && (
        <p>
          <a
            href={article.data.sourceUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            {article.data.sourceUrl}
          </a>
        </p>
      )
    }
  </article>

  {article.data.supplyCta && <SupplyCta lang={lang} placement="article" />}

  <ArticleFooterNav article={article} lang={lang} />

  <GiscusComments
    lang={lang}
    term={article.data.translationKey}
  />

  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonld)}
  />
  {faqItems.length >= 2 && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.q,
          acceptedAnswer: { '@type': 'Answer', text: item.a }
        }))
      })}
    />
  )}
  <script is:inline>
    document.addEventListener('click', function (event) {
      var img = event.target.closest('.prose img');
      if (!img || img.closest('a')) return;
      event.preventDefault();
      var box = document.createElement('div');
      box.className = 'en-lightbox';
      var big = document.createElement('img');
      big.src = img.currentSrc || img.src;
      big.alt = img.alt || '';
      box.appendChild(big);
      document.body.appendChild(box);
      function close() {
        box.remove();
        document.removeEventListener('keydown', onKey);
      }
      function onKey(e) { if (e.key === 'Escape') close(); }
      box.addEventListener('click', close);
      document.addEventListener('keydown', onKey);
    });
  </script>
  <script is:inline>
    (function () {
      var heads = document.querySelectorAll('.prose h2[id], .prose h3[id]');
      heads.forEach(function (h) {
        var link = document.createElement('a');
        link.className = 'heading-anchor';
        link.href = '#' + h.id;
        link.setAttribute('aria-label', 'Link to this section');
        link.textContent = '#';
        h.appendChild(link);
      });
    })();
  </script>
</Base>

<style>
  .en-breadcrumb {margin:0 0 18px; font:500 12px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif;}
  .en-breadcrumb ol {display:flex; flex-wrap:wrap; gap:6px; margin:0; padding:0; list-style:none;}
  .en-breadcrumb li {display:inline-flex; align-items:center; gap:6px; color:#6f7772; min-width:0;}
  .en-breadcrumb a {color:#8f3c2c;}
  .en-breadcrumb a:hover {text-decoration:underline;}
  .en-breadcrumb span[aria-current] {color:#3d4a44; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:min(52ch,60vw);}
  .en-breadcrumb__sep {color:#b6aaa0;}
</style>
