---
import Base from '../../../../layouts/Base.astro';
import EmailCapture from '../../../../components/EmailCapture.astro';
import { e6Panels, bytes } from '../../../../data/e6-panels';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'zh' } }];
}

const lang = Astro.params.lang === 'zh' ? 'zh' : 'en';
const zh = lang === 'zh';

const translations = { en: '/en/e-paper/e6/', zh: '/zh/e-paper/e6/' };
const count = e6Panels.length;

const breadcrumbs = [
  { name: zh ? '首页' : 'Home', path: `/${lang}/` },
  { name: 'E-paper', path: `/${lang}/e-paper/` },
  { name: zh ? 'E6 尺寸' : 'E6 sizes' }
];

const fmt = (n: number) => n.toLocaleString('en-US');

const title = zh ? `E6 电子纸面板：全部 ${count} 个尺寸` : `E6 E-Paper Panels: All ${count} Sizes`;
const description = zh
  ? `E6（Spectra 6）六色电子纸的全部 ${count} 个尺寸，从 1.18 到 31.5 寸：分辨率、像素数、RAW4 与 RAW8 每帧字节数，每个尺寸一页。`
  : `Every E6 (Spectra 6) six-colour size from 1.18 to 31.5 inch: resolution, pixel count and RAW4 / RAW8 bytes per frame, one page each.`;
---

<Base
  lang={lang}
  title={title}
  description={description}
  translations={translations}
  breadcrumbs={breadcrumbs}
>
  <section class="e6-hub">
    <p class="eyebrow">EMBEDDEDNOTE · E-PAPER · E6</p>

    <h1>{zh ? 'E6 电子纸面板：全部尺寸' : 'E6 e-paper panels: every size'}</h1>

    <p class="e6-hub-lede">
      {zh
        ? `E6（E Ink Spectra 6）是一个六色家族，不是一块屏：黑白黄红蓝绿，每像素 3 位颜色信息按 4 位半字节存放。下面是我们实际走通过的 ${count} 个尺寸，每个尺寸单独一页，写清楚它一帧要多少字节、对主控内存意味着什么。`
        : `E6 (E Ink Spectra 6) is a family, not a panel: six colours, three bits of colour per pixel carried in a four-bit nibble. These are the ${count} sizes we have actually handled. Each one has its own page with the frame size and what that buffer means for your MCU.`}
    </p>

    <div class="e6-hub-table-wrap">
      <table class="e6-hub-table">
        <thead>
          <tr>
            <th>{zh ? '尺寸' : 'Size'}</th>
            <th>{zh ? '分辨率' : 'Resolution'}</th>
            <th>{zh ? '像素数' : 'Pixels'}</th>
            <th>RAW4</th>
            <th>RAW8</th>
            <th>PPI</th>
          </tr>
        </thead>
        <tbody>
          {e6Panels.map((panel) => (
            <tr>
              <td>
                <a href={`/${lang}/e-paper/e6/${panel.slug}/`}>{panel.sizeIn} in</a>
              </td>
              <td>{fmt(panel.width)} × {fmt(panel.height)}</td>
              <td>{fmt(panel.pixels)}</td>
              <td>{bytes(panel.raw4)}</td>
              <td>{bytes(panel.raw8)}</td>
              <td>{panel.ppi ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="e6-hub-note">
      {zh
        ? 'PPI 一栏的破折号表示该型号的数据手册没有公布像素密度或有效显示区。我们不用对角线反推——对角线是外形尺寸，分辨率是玻璃尺寸，两者相关但不成公式。'
        : 'A dash in the PPI column means the datasheet for that part does not publish pixel density or an active area. We do not back it out of the diagonal: a diagonal is an outline measurement and resolution is a glass measurement.'}
    </p>

    <EmailCapture
      lang={lang}
      source={`e6-hub-${lang}`}
      interests={e6Panels.map((panel) => `${panel.sizeIn} in`)}
    />

    <h2>{zh ? '怎么用这张表' : 'How to use this table'}</h2>
    <p>
      {zh
        ? '先看字节数，再看分辨率。同一块屏在 RAW4 和 RAW8 下差一倍，这个差额通常比"选哪个分辨率"更早决定你的主控和内存。选型时把目标产量、接口和认证一起说，报价才准。'
        : 'Read the byte column before the resolution column. The same panel costs twice as much in RAW8 as in RAW4, and that difference usually decides your MCU and memory earlier than the resolution choice does. Bring volume, interface and certification into the first email so the quote is real.'}
    </p>

    <h2>{zh ? '相关' : 'Related'}</h2>
    <ul class="e6-hub-related">
      <li><a href={`/${lang}/articles/epaper-size-chart/`}>{zh ? '尺寸与分辨率对照（含 CSV 下载）' : 'Size and resolution chart (with CSV)'}</a></li>
      <li><a href={`/${lang}/tools/epaper-image-converter/`}>{zh ? '图像转换器：导出 RAW4 / RAW8' : 'Image converter: export RAW4 / RAW8'}</a></li>
      <li><a href={`/${lang}/articles/epaper-names-decoded/`}>{zh ? '电子纸命名对照：E6、SSD1680、UC8151' : 'E-paper names decoded: E6, SSD1680, UC8151'}</a></li>
      <li><a href={`/${lang}/e-paper/glossary/`}>{zh ? '术语表' : 'Glossary'}</a></li>
    </ul>

    <div class="e6-hub-cta">
      <p>
        {zh
          ? '要样品或报价，把尺寸、分辨率、颜色数、接口、目标产量和时间节点发到邮箱，一个工作日内回。'
          : 'For a sample or a quote, send the size, resolution, colour count, interface, target volume and timeline. We reply within one working day.'}
      </p>
      <p class="e6-hub-email">
        <a href={`mailto:xudeng@datadelta.cn?subject=${encodeURIComponent(zh ? 'E6 电子纸选型咨询' : 'E6 e-paper enquiry')}`}>xudeng@datadelta.cn</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .e6-hub {
    width: min(100%, 900px);
    margin: 0 auto;
    padding: clamp(38px, 6vw, 72px) 0 clamp(64px, 8vw, 110px);
  }
  .e6-hub h1 {
    font: 700 clamp(34px, 4.2vw, 52px)/1.14 Georgia, 'Noto Serif SC', serif;
    letter-spacing: -.025em;
    margin: 12px 0 22px;
    color: #17211e;
  }
  .e6-hub h2 {
    font: 700 clamp(20px, 2.2vw, 26px)/1.3 Georgia, 'Noto Serif SC', serif;
    margin: 42px 0 14px;
    color: #17211e;
  }
  .e6-hub-lede {
    color: #4d574f;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.75;
    margin: 0 0 30px;
  }
  .e6-hub-table-wrap {
    overflow-x: auto;
    border: 1px solid #e3dccf;
    background: #fffdf9;
  }
  .e6-hub-table {
    width: 100%;
    min-width: 620px;
    border-collapse: collapse;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .e6-hub-table th {
    background: #f4eee3;
    text-align: left;
    font-weight: 700;
    padding: 11px 14px;
    border-bottom: 2px solid #d6cdbd;
    white-space: nowrap;
  }
  .e6-hub-table td {
    padding: 10px 14px;
    border-bottom: 1px solid #ece5d8;
  }
  .e6-hub-table tr:last-child td { border-bottom: 0; }
  .e6-hub-table a {
    color: #b94530;
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .e6-hub-note {
    color: #6a736c;
    font-size: 13.5px;
    line-height: 1.7;
    margin: 12px 0 0;
  }
  .e6-hub p { color: #37413b; line-height: 1.8; }
  .e6-hub-related {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .e6-hub-related a { color: #b94530; text-underline-offset: 3px; }
  .e6-hub-cta {
    margin-top: 46px;
    border-top: 1px solid #d0c8bb;
    padding-top: 24px;
  }
  .e6-hub-cta p { color: #4d574f; line-height: 1.75; margin: 0 0 12px; }
  .e6-hub-email { font-size: clamp(18px, 2vw, 22px); }
  .e6-hub-email a { color: #b94530; text-underline-offset: 3px; overflow-wrap: anywhere; }
</style>
