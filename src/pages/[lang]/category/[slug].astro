---
import CategoryView from '../../../components/CategoryView.astro';
import { channels } from '../../../i18n/ui';
export function getStaticPaths() {
  return ['en','zh'].flatMap(lang => channels.map(({slug}) => ({params:{lang,slug}})));
}
const {lang,slug} = Astro.params;
---
<CategoryView lang={lang} slug={slug} page={1} />
