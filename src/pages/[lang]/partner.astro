---
import Base from '../../layouts/Base.astro';
export function getStaticPaths(){return ['en','zh'].map(lang=>({params:{lang}}));}
const lang=Astro.params.lang==='zh'?'zh':'en';
const zh=lang==='zh';
const types=zh
  ?['面板与模组供货','方案设计与定制开发','技术资料与联合内容']
  :['Panel and module supply','Solution design and custom development','Technical material and joint content'];
const blurbs=zh
  ?[
    '电子纸面板与模组:黑白、BWRY、E6 六色,0.97 至 31.5 寸,含驱动板与定制排线。',
    'TCON 与时序板、BLE + Wi-Fi 整机、自研图像处理算法、结构与认证。',
    '数据手册整理、应用笔记、联合技术文章。我们不接受付费评测,也不出售正面结论。'
  ]
  :[
    'E-paper panels and modules: monochrome, BWRY and E6 six-colour from 0.97 to 31.5 inch, with driver boards and custom FPC.',
    'TCON and bridge boards, BLE plus Wi-Fi products, our own image engine, mechanics and certification.',
    'Datasheet work, application notes, joint technical articles. We do not sell reviews, and a conclusion is not for sale.'
  ];
const links=zh
  ?[{href:`/${lang}/supply/`,label:'供货与打样 →'},{href:`/${lang}/solutions/`,label:'方案设计 →'},{href:`/${lang}/about/`,label:'编辑与证据说明 →'}]
  :[{href:`/${lang}/supply/`,label:'Supply and samples →'},{href:`/${lang}/solutions/`,label:'Solution design →'},{href:`/${lang}/about/`,label:'Editorial method →'}];
---
<Base
  lang={lang}
  title={zh?'商务合作':'Business cooperation'}
  description={zh
    ? 'EmbeddedNote 的商务合作:电子纸面板与模组供货、方案设计与定制开发、技术资料合作。编辑内容不接受付费结论。'
    : 'Business cooperation with EmbeddedNote: e-paper panel and module supply, solution design and custom development, and technical material collaboration. Editorial conclusions are not for sale.'}
  translations={{en:'/en/partner/',zh:'/zh/partner/'}}
>
<section class="en-partner" data-pagefind-body>
  <p class="eyebrow">EMBEDDEDNOTE / {zh?'商务合作':'BUSINESS COOPERATION'}</p>
  <h1>{zh?'商务合作':'Business cooperation'}</h1>
  <p class="lead">
    {zh
      ? '这一页处理的是商业问题:买屏、做方案、整理技术资料。它和网站上的文章是两件事——文章按证据写,合作按项目谈。'
      : 'This page is for commercial enquiries: panels, product design, technical material. It is separate from the articles. The articles follow the evidence; the projects follow a contract.'}
  </p>

  <div class="partner-grid">
    {types.map((t,i)=><article>
      <span>0{i+1}</span>
      <h2>{t}</h2>
      <p>{blurbs[i]}</p>
      <a class="partner-link" href={links[i].href}>{links[i].label}</a>
    </article>)}
  </div>

  <div class="partner-boundary">
    <h2>{zh?'一条边界':'One boundary'}</h2>
    <p>
      {zh
        ? '我们不写软文,也不因为有人付钱就改变技术结论——包括我们自己供货的型号。如果一篇文章里提到某个产品,它出现的原因是它在那个位置上说得通,不是因为它是客户。'
        : 'We do not write sponsored conclusions, and paying us does not change a technical finding, including about parts we supply. When a product appears in an article, it is because it belongs there, not because it is a customer.'}
    </p>
  </div>

  <div class="partner-contact">
    <h2>{zh?'说明你的需求':'Tell us what you need'}</h2>
    <p>{zh?'填写后点击按钮,会用你的邮件客户端生成一封邮件;信息不会上传到网站。':'Fill this in and the button composes an email in your mail app. Nothing is uploaded to the site.'}</p>
    <form id="en-partner-form">
      <label>{zh?'合作类型':'Type'}<select name="type">{types.map(t=><option>{t}</option>)}</select></label>
      <label>{zh?'公司':'Company'}<input name="company" maxlength="120" required autocomplete="organization"/></label>
      <label>{zh?'联系邮箱':'Email'}<input name="email" type="email" maxlength="160" required autocomplete="email"/></label>
      <label class="full">{zh?'具体需求':'What you need'}<textarea name="brief" rows="5" maxlength="2000" required></textarea></label>
      <button type="submit">{zh?'生成邮件':'Compose email'}</button>
      <p class="full note">{zh?'也可以直接写信到':'Or write to'} <a href="mailto:xden2019@gmail.com" data-en-event="partner_email_click" data-en-placement="partner">xden2019@gmail.com</a></p>
    </form>
  </div>
</section>
</Base>
<script>
  const f=document.querySelector<HTMLFormElement>('#en-partner-form');
  f?.addEventListener('submit',event=>{
    event.preventDefault();if(!f.reportValidity())return;
    const data=new FormData(f);
    const val=(key:string)=>String(data.get(key)||'').trim();
    const subject=`Business cooperation - ${val('type')}`;
    const body=`Company: ${val('company')}\nEmail: ${val('email')}\nType: ${val('type')}\n\n${val('brief')}`;
    (window as any).embeddednoteAnalytics?.capture?.('partner_email_compose',{type:val('type'),page:location.pathname});
    location.href=`mailto:xden2019@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>
<style>
.en-partner{max-width:1050px;margin:0 auto;padding:40px 0 90px;color:#17211e}
.en-partner h1{font:700 clamp(32px,4.5vw,54px)/1.12 Georgia,'Noto Serif SC',serif;max-width:900px;letter-spacing:-.025em}
.en-partner .lead{font:clamp(16px,1.7vw,19px)/1.8 system-ui,sans-serif;max-width:800px;color:#58625c;margin:18px 0 34px}
.partner-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
.partner-grid article{background:#faf7f0;border:1px solid #d0c8bb;border-radius:5px;padding:23px}
.partner-grid span{font:700 12px system-ui;color:#b94530;letter-spacing:.1em}
.partner-grid h2,.partner-contact h2,.partner-boundary h2{font:700 clamp(21px,2.3vw,29px)/1.25 Georgia,'Noto Serif SC',serif;margin:12px 0}
.partner-grid p,.partner-contact p,.partner-boundary p{line-height:1.75;color:#59645e}
.partner-link{display:inline-block;margin-top:10px;color:#b94530;font-weight:700;text-underline-offset:3px}
.partner-boundary{margin-top:22px;padding:24px 25px;border-left:4px solid #17211e;background:#f4eee3}
.partner-boundary h2{margin-top:0}
.partner-contact{margin-top:26px;padding:25px;border:1px solid #d0c8bb;background:#faf7f0;border-radius:5px}
.partner-contact form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.partner-contact label{display:grid;gap:6px;font:600 13px system-ui,sans-serif}
.partner-contact .full{grid-column:1/-1}
.partner-contact input,.partner-contact select,.partner-contact textarea{font:15px system-ui,sans-serif;padding:12px;border:1px solid #bcb4a8;border-radius:3px;min-width:0;background:#fff;color:#17211e}
.partner-contact button{background:#b94530;color:white;border:0;border-radius:3px;padding:12px 18px;font:600 14px system-ui;cursor:pointer;justify-self:start}
.partner-contact button:hover{background:#923322}
.partner-contact .note{font-size:13px;margin:0}
.partner-contact a{color:#b94530}
@media(max-width:650px){.partner-grid,.partner-contact form{grid-template-columns:1fr}.en-partner{padding-top:25px}.partner-contact{padding:17px}}
</style>
