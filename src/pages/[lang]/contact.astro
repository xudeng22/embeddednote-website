---
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'zh' } }
  ];
}

const lang = Astro.params.lang === 'zh' ? 'zh' : 'en';
const zh = lang === 'zh';
const translations = { en: '/en/contact/', zh: '/zh/contact/' };
---
<Base
  lang={lang}
  title={zh ? '联系我们' : 'Contact'}
  description={zh
    ? '联系 EmbeddedNote：技术项目推荐、勘误、编辑合作与商务合作咨询。'
    : 'Contact EmbeddedNote for project suggestions, technical corrections, and editorial or partnership enquiries.'}
  translations={translations}
>
  <section class="en-contact-page">
    <p class="eyebrow">EMBEDDED NOTES · {zh ? '联系我们' : 'CONTACT'}</p>
    <h1>{zh ? '联系我们' : 'Contact'}</h1>
    <p class="en-contact-intro">
      {zh
        ? '欢迎推荐项目、指出技术错误;供货、方案设计与资料合作请走商务合作。'
        : 'Project suggestions and technical corrections are welcome. For panels, design work or datasheets, use the business cooperation page.'}
    </p>
        <p><a href={`/${lang}/partner/`} data-en-event="partner_link_click" data-en-placement="contact">{zh ? '商务合作 →' : 'Business cooperation →'}</a></p>
<p class="en-contact-email">
      <strong>{zh ? '邮箱：' : 'Email:'}</strong>
      <a href="mailto:xudeng@datadelta.cn">xudeng@datadelta.cn</a>
    </p>
  </section>
</Base>
<style>
  .en-contact-page {
    width: min(100%, 760px);
    margin: 0 auto;
    padding: clamp(38px, 6vw, 76px) 0 clamp(64px, 8vw, 110px);
  }
  .en-contact-page h1 {
    font: 700 clamp(36px, 4vw, 55px)/1.15 Georgia, 'Noto Serif SC', serif;
    letter-spacing: -.025em;
    margin: 12px 0 24px;
    color: #17211e;
  }
  .en-contact-intro {
    color: #59645e;
    font-size: clamp(16px, 1.5vw, 19px);
    line-height: 1.8;
    margin: 0 0 25px;
  }
  .en-contact-email {
    margin: 0;
    border-top: 1px solid #d0c8bb;
    padding-top: 22px;
    font-size: clamp(16px, 1.5vw, 19px);
    overflow-wrap: anywhere;
  }
  .en-contact-email strong { margin-right: 8px; }
  .en-contact-email a { color: #b94530; text-underline-offset: 3px; }
  .en-contact-email a:hover { text-decoration: underline; }
</style>
