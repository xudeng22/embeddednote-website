---
import Base from '../../layouts/Base.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths() {
  const about = await getCollection('about');
  return await Promise.all(about.map(async (entry) => ({
    params: {lang: entry.data.locale},
    props: {entry}
  })));
}
const {entry} = Astro.props;
const lang = entry.data.locale;
const {Content} = await render(entry);
---
<Base lang={lang} title={entry.data.title} description={entry.data.description} translations={{en:'/en/about/',zh:'/zh/about/'}}>
  <article class="prose about-prose" data-pagefind-body>
    <Content />
  </article>
</Base>
